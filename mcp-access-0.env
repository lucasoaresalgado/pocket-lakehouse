# Default MinIO credentials of the MCP server in read-only mode (MCP_EDIT_ACCESS=0).
# The user can only list and read the bucket (policy created by scripts/init-minio.sh), so it is safe to commit.
# MinIO only listens on 127.0.0.1. Change the password here and re-run ./scripts/init-minio.sh if you want another.
MCP_S3_USER=mcp-reader
MCP_S3_PASSWORD=mcp-readonly-default
