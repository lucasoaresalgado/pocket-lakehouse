# Rendered by Terraform (terraform/templates/spark-defaults.conf.tftpl); the values come from terraform/variables.tf.
spark.eventLog.enabled           true
spark.eventLog.dir               /spark-events
spark.history.fs.logDirectory    /spark-events
# Small-cluster tuning: few shuffle partitions, modest executors
spark.sql.shuffle.partitions     ${shuffle_partitions}
spark.sql.adaptive.enabled       true
spark.executor.memory            ${executor_memory_mb}m
spark.executor.cores             ${worker_cores}
spark.cores.max                  ${cores_max}
spark.driver.memory              ${driver_memory_mb}m
spark.driver.bindAddress         0.0.0.0
spark.serializer                 org.apache.spark.serializer.KryoSerializer
spark.hadoop.fs.permissions.umask-mode 000
spark.sql.mapKeyDedupPolicy      LAST_WIN
# MinIO (same Docker network). Credentials come from AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY (environment).
spark.hadoop.fs.s3a.endpoint                 http://minio:9000
spark.hadoop.fs.s3a.path.style.access        true
spark.hadoop.fs.s3a.connection.ssl.enabled   false
spark.hadoop.fs.s3a.aws.credentials.provider com.amazonaws.auth.EnvironmentVariableCredentialsProvider
spark.hadoop.fs.s3a.impl                     org.apache.hadoop.fs.s3a.S3AFileSystem
